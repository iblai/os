# Refuse packages published less than a week ago — a supply-chain cooldown so a
# hijacked release is caught and yanked before we ever install it.
# NOTE: pnpm only honours minimumReleaseAge from v10.16; this repo pins an older
# pnpm, so the ACTIVE cooldown is enforced by Dependabot (see dependabot.yml).
# This line keeps us covered once pnpm is bumped. Asserted by workflow-security.yml.
minimumReleaseAge=7
ignore-scripts=true
block-exotic-subdeps=true
