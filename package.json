{
  "name": "ibl-web-nextjs-mentor-spa",
  "version": "0.141.0",
  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "25.3.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--no-experimental-webstorage' next dev",
    "build": "next build && ./scripts/post-build.sh",
    "start": "PORT=${PORT:-3000} node server-wrapper.js",
    "lint": "next lint --fix && pnpm typecheck",
    "lint:check": "next lint && pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format-lint": "npm run format && npm run lint",
    "prepare": "husky",
    "test": "vitest run",
    "gallery": "pnpm build && vitest run --config vitest.gallery.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "release": "release-it",
    "check-types": "tsc --noEmit",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "tauri:build:debug": "pnpm build && cargo tauri build --debug",
    "tauri:build:mas": "pnpm build && cargo tauri build",
    "tauri:build:devid": "pnpm build && cargo tauri build --config src-tauri/tauri.devid.conf.json",
    "test:e2e": "mkdir -p playwright/.auth && echo '{\"cookies\":[],\"origins\":[]}' > playwright/.auth/user-chrome.json && echo '{\"cookies\":[],\"origins\":[]}' > playwright/.auth/user-edge.json && echo '{\"cookies\":[],\"origins\":[]}' > playwright/.auth/user-safari.json && echo '{\"cookies\":[],\"origins\":[]}' > playwright/.auth/user-firefox.json && playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:tauri": "wdio run e2e-tauri/wdio.conf.ts",
    "test:tauri:windows": "wdio run e2e-tauri/wdio.conf.ts",
    "test:tauri:linux": "GDK_BACKEND=x11 WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 xvfb-run -a pnpm test:tauri",
    "test:tauri:macos": "node -e \"console.error('tauri-driver has no macOS support (WKWebView exposes no WebDriver) — run the desktop e2e on Linux or Windows.'); process.exit(1)\"",
    "test:tauri:coverage": "node e2e-tauri/scripts/check-journey-coverage.mjs",
    "test:tauri:auth:save": "node -e \"console.log('Auth state persists in '+ (process.env.TAURI_E2E_DATA_HOME || require('node:path').resolve(require('node:os').homedir(), '.local/share/iblai-os-test')) + ' — nothing to do; it is kept between runs.')\"",
    "test:tauri:auth:delete": "node -e \"const p=process.env.TAURI_E2E_DATA_HOME || require('node:path').resolve(require('node:os').homedir(), '.local/share/iblai-os-test'); require('node:fs').rmSync(p,{recursive:true,force:true}); console.log('removed '+p)\"",
    "tauri:bump": "node scripts/tauri-bump.mjs"
  },
