#!/bin/sh

sh scripts/fix-yalc.sh

echo "Running typecheck..."
pnpm typecheck

echo "Running lint..."
pnpm lint:check

echo "Running build..."
pnpm build

echo "Running unit tests..."
pnpm test

echo "Checking test coverage for changed files..."
bash ./scripts/check-test-coverage.sh

echo "Checking E2E journey coverage for changed files..."
node e2e/scripts/check-journey-coverage.mjs --no-regress

# Claude code review runs locally (moved off GitHub Actions — no Claude in CI).
# Requires the `claude` CLI to be installed; the push is blocked without it.
if ! command -v claude >/dev/null 2>&1; then
  echo "ERROR: 'claude' CLI not found. Install it to run the required pre-push review."
  echo "       https://docs.claude.com/en/docs/claude-code"
  exit 1
fi
echo "Claude is reviewing your code..."
claude --print "/code-review"
