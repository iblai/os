{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "composite": true,
    "declaration": true,
    "types": [],
    "typeRoots": ["./node_modules/@types", "./types"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "global.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  // `exclude` wins over `include`, so the two e2e configs that
  // __tests__/playwright-security-config.test.ts imports are listed as `files`,
  // which `exclude` does not filter. The e2e specs themselves stay out.
  "files": ["e2e/mcp.config.ts", "e2e/playwright.config.ts"],
  "exclude": [
    "**/node_modules",
    ".next",
    "e2e",
    "e2e-tauri",
    "src-tauri/target",
    "extensions",
    "seed.spec.ts"
  ]
}
