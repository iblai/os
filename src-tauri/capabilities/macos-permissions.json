{
  "$schema": "../gen/schemas/macOS-schema.json",
  "identifier": "macos-permissions",
  "description": "macOS Accessibility permission check/request for Cowork (GhostOS). The `default` permission set is empty, so the accessibility commands are granted explicitly.",
  "platforms": ["macOS"],
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": [
      "https://*.iblai.app/*",
      "https://*.iblai.org/*",
      "https://*.ibl.ai/*",
      "http://127.0.0.1:*/*",
      "http://localhost:*/*",
      "http://localhost:3456",
      "http://localhost:3456/*",
      "mentor://localhost/*"
    ]
  },
  "permissions": [
    "macos-permissions:allow-check-accessibility-permission",
    "macos-permissions:allow-request-accessibility-permission"
  ]
}
