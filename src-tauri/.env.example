# ibl.ai Configuration
# Copy this file to .env and customize as needed
# (On dev checkouts, src-tauri/.env.local and src-tauri/.env.production are
# auto-loaded at startup too — shell env wins, then .env.local, then
# .env.production, then .env.)

# App URL - the URL that the ibl.ai app loads
#
# For development (debug builds):
#   Defaults to https://os.ibl.ai if not set
#
# For production (release builds):
#   Defaults to https://os.ibl.ai if not set
#
# To override, set the TAURI_APP_URL environment variable:
# TAURI_APP_URL=https://os.ibl.ai

# For custom deployments, uncomment and set your URL:
# TAURI_APP_URL=https://your-custom-mentor-url.example.com

# The mobile/lib entry point reads TAURI_DEV_URL instead (desktop reads TAURI_APP_URL):
# TAURI_DEV_URL=http://localhost:3000
__DEVTOOLS_LOCAL_DEVELOPMENT=1
IBLAI_PLATFORM_DOMAIN=iblai.app
IBLAI_AUTH_URL=https://login.iblai.app

# Touch-test a vibe pre-release: sync code mode's skills from this release tag
# instead of the latest release (dev builds; remove the line to go back to latest).
# IBL_VIBE_SKILLS_TAG=v2.11.0-rc.1

# Screenshots: show the signed-in Claude Code account as ja********@example.com (dev builds).
# IBL_MASK_ACCOUNT_EMAIL=1

# Rust-side error reporting (src/telemetry.rs). Reports into the SAME project as
# the web app by default, tagged runtime:tauri-rust and released as
# ibl-ai-os@<version> so the Rust events stay findable there. Nothing to set for
# that to work. Set this only to split the Rust events into their own project —
# release builds bake it in via build.rs, a dev build reads it here.
# IBL_SENTRY_DSN_DESKTOP=https://<key>@sentry.ibl.network/<project>

# A debug build reports nothing unless this is also set: dev noise would
# otherwise drown the production signal in a project the whole product uses.
# IBL_SENTRY_DEBUG=1

# Turn Rust error reporting off on this machine. Per machine, `telemetry: false`
# in ~/.local/share/iblai/settings.json does the same thing permanently.
# IBL_TELEMETRY=off
